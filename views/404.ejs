<%- include('partials/header') %>

<div style="text-align: center; padding: 4rem 1.5rem; background: var(--card-bg); border-radius: var(--radius); border: 1px solid var(--border-color); max-width: 600px; margin: 3rem auto; box-shadow: var(--shadow);">
  <div style="font-size: 3.5rem; margin-bottom: 1rem;">🔍</div>
  <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 0.75rem;"><%= typeof title !== 'undefined' ? title : 'Page Not Found' %></h1>
  <p style="color: var(--text-muted); font-size: 1.05rem; margin-bottom: 2rem;">
    <%= typeof message !== 'undefined' ? message : 'The page or product you are looking for does not exist.' %>
  </p>
  <a href="/" class="btn btn-primary">Return to Shop</a>
</div>

<%- include('partials/footer') %>
